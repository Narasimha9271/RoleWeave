PORT=3001
HOST=127.0.0.1
# Required for cloud accounts and storage; use the public anon key, never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only AI configuration. Groq is preferred; limits depend on your account.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional alternative: set AI_PROVIDER=openai explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Full Python executable path, or python if available on PATH.
PYTHON_BIN=python

# Render uses one trusted reverse proxy. Leave 0 when running directly.
TRUST_PROXY_HOPS=0
